import { Button, LineEdit, CheckBox, ListView, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct FileEntry {
    name: string,
    size: string,
    packed: string,
    entry-type: string,
    modified: string,
    crc32: string,
    is-dir: bool,
    icon-kind: string,
    is-selected: bool,
}

component ToolbarButton inherits Rectangle {
    in property <image> icon;
    in property <image> icon-light;
    in property <string> caption;
    in property <bool> dark-mode: true;
    callback activated();

    width: 62px;
    height: 64px;
    border-radius: 4px;

    touch := TouchArea {
        clicked => { root.activated(); }
    }

    background: touch.pressed
        ? (root.dark-mode ? #2c2c2c : #dcdcdc)
        : (touch.has-hover ? (root.dark-mode ? #262626 : #eaeaea) : transparent);
    border-width: touch.has-hover ? 1px : 0px;
    border-color: root.dark-mode ? #333333 : #cccccc;

    Image {
        source: root.dark-mode ? root.icon : root.icon-light;
        x: (parent.width - 34px) / 2;
        y: 5px;
        width: 34px;
        height: 34px;
        image-fit: contain;
    }

    Text {
        text: root.caption;
        x: 2px;
        y: 42px;
        width: parent.width - 4px;
        color: touch.has-hover
            ? (root.dark-mode ? #ffffff : #111111)
            : (root.dark-mode ? #c8c8c8 : #2c2c2c);
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

component MenuItem inherits Rectangle {
    in property <string> caption;
    in property <bool> dark-mode: true;
    in property <bool> active: false;
    callback activated();

    height: 25px;
    width: label.preferred-width + 18px;
    border-radius: 3px;

    touch := TouchArea {
        clicked => { root.activated(); }
    }

    background: (root.active || touch.has-hover)
        ? (root.dark-mode ? #2c2c2c : #e8e8e8)
        : transparent;

    label := Text {
        text: root.caption;
        x: 9px;
        y: 0px;
        height: parent.height;
        color: root.dark-mode ? #e2e2e2 : #1a1a1a;
        font-size: 12px;
        vertical-alignment: center;
    }
}

component DropdownMenu inherits Rectangle {
    in property <bool> dark-mode: true;
    background: root.dark-mode ? #171717 : #f7f7f5;
    border-width: 1px;
    border-color: root.dark-mode ? #2c2c2c : #d0d0d0;
    border-radius: 5px;
    drop-shadow-blur: 10px;
    drop-shadow-color: #000000aa;
    drop-shadow-offset-y: 4px;
}

component DropdownMenuItem inherits Rectangle {
    in property <string> text;
    in property <string> shortcut: "";
    in property <bool> dark-mode: true;
    callback activated();

    height: 27px;
    border-radius: 3px;
    background: item-touch.has-hover
        ? (root.dark-mode ? #2c2c2c : #e8eaed)
        : transparent;

    item-touch := TouchArea {
        clicked => { root.activated(); }
    }

    HorizontalBox {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Text {
            text: root.text;
            color: root.dark-mode ? #e5e5e5 : #1a1a1a;
            font-size: 11.5px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.shortcut != "" : Text {
            text: root.shortcut;
            color: root.dark-mode ? #888888 : #777777;
            font-size: 10.5px;
            vertical-alignment: center;
        }
    }
}

component MenuDivider inherits Rectangle {
    in property <bool> dark-mode: true;
    height: 1px;
    background: root.dark-mode ? #2a2a2a : #e2e2e2;
}

component NavButton inherits Rectangle {
    in property <image> icon;
    in property <image> icon-light;
    in property <bool> dark-mode: true;
    callback activated();

    width: 28px;
    height: 26px;
    border-radius: 4px;

    touch := TouchArea {
        clicked => { root.activated(); }
    }

    background: touch.pressed
        ? (root.dark-mode ? #2c2c2c : #d8d8d8)
        : (touch.has-hover ? (root.dark-mode ? #232323 : #ededed) : (root.dark-mode ? #1a1a1a : #f6f6f4));
    border-width: 1px;
    border-color: root.dark-mode ? #2c2c2c : #cccccc;

    Image {
        source: root.dark-mode ? root.icon : root.icon-light;
        x: 5px;
        y: 4px;
        width: 18px;
        height: 18px;
        image-fit: contain;
    }
}

component SocialButton inherits Rectangle {
    in property <image> icon;
    in property <image> icon-light;
    in property <string> url;
    in property <bool> dark-mode: true;
    callback activated(string);

    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: s-touch.has-hover
        ? (root.dark-mode ? #2a2a2a : #dedede)
        : transparent;

    s-touch := TouchArea {
        clicked => { root.activated(root.url); }
    }

    Image {
        source: root.dark-mode ? root.icon : root.icon-light;
        x: 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        image-fit: contain;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> caption;
    in property <bool> dark-mode: true;
    in property <TextHorizontalAlignment> text-align: left;
    callback clicked();

    height: 25px;
    background: h-touch.pressed
        ? (root.dark-mode ? #2a2a2a : #d5d9e0)
        : (h-touch.has-hover ? (root.dark-mode ? #222222 : #dfe3ea) : transparent);

    h-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.caption;
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: parent.height;
        color: h-touch.has-hover
            ? (root.dark-mode ? #e0e0e0 : #111111)
            : (root.dark-mode ? #9a9a9a : #555555);
        font-size: 11.5px;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: root.text-align;
        overflow: elide;
    }
}

export component MainWindow inherits Window {
    title: "Mickey RAR";
    width: 1040px;
    height: 660px;
    icon: @image-url("../assets/icon-window.png");
    background: root.dark-mode ? #101010 : #f5f6f4;
    forward-focus: key-handler;

    in-out property <string> location: "";
    in-out property <string> status: "Selected 0 bytes in 0 files";
    in-out property <string> selected-info <=> root.status;
    in-out property <string> total-info: "Total 0 folders and 0 bytes in 0 files";
    in-out property <[FileEntry]> entries: [];
    in-out property <int> selected-index: -1;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-find: false;
    in-out property <string> find-query: "";
    in-out property <bool> show-wizard: false;
    in-out property <bool> show-rename: false;
    in-out property <string> rename-old-name: "";
    in-out property <string> rename-new-name: "";
    in-out property <bool> show-info-dialog: false;
    in-out property <string> info-dialog-title: "";
    in-out property <string> info-dialog-body: "";
    in-out property <bool> show-update-dialog: false;
    in-out property <string> update-dialog-title: "";
    in-out property <string> update-dialog-body: "";
    in-out property <bool> update-has-new: false;
    in-out property <bool> update-downloading: false;
    in-out property <string> update-download-url: "";
    in-out property <bool> show-context-menu: false;
    in-out property <length> context-menu-x: 100px;
    in-out property <length> context-menu-y: 100px;
    in-out property <[string]> available-drives: ["C:\\"];
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-ascending: true;
    in-out property <bool> arabic-mode: false;
    in-out property <bool> solid-mode: true;
    in-out property <string> thread-count: "auto";
    in-out property <bool> dark-mode: true;
    in-out property <int> active-menu: 0;

    callback toggle-language();
    callback toggle-theme();
    callback choose-folder();
    callback navigate-path(string);
    callback open-archive();
    callback create-archive();
    callback create-sfx-archive();
    callback create-encrypted-archive();
    callback extract-archive();
    callback test-archive();
    callback refresh();
    callback nav-up();
    callback select-entry(int);
    callback select-entry-adv(int, bool, bool);
    callback open-entry(string);
    callback open-selected();
    callback start-drag(int);
    callback sort-by(int);
    callback run-find(string);
    callback clear-find();
    callback start-rename();
    callback confirm-rename(string, string);
    callback copy-selected-path();
    callback save-compression-settings(string, bool);
    callback set-default-app();
    callback open-url(string);
    callback toolbar-info(string);

    // Menu actions:
    callback select-all();
    callback clear-selection();
    callback invert-selection();
    callback exit-app();
    callback view-selected();
    callback delete-selected();
    callback show-archive-info();
    callback scan-viruses();
    callback run-benchmark();
    callback nav-favorite(string);
    callback show-about();
    callback check-updates();
    callback install-update();

    key-handler := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.active-menu = 0;
                root.show-context-menu = false;
                if (root.show-update-dialog && !root.update-downloading) { root.show-update-dialog = false; return accept; }
                if (root.show-rename) { root.show-rename = false; return accept; }
                if (root.show-info-dialog) { root.show-info-dialog = false; return accept; }
                if (root.show-wizard) { root.show-wizard = false; return accept; }
                if (root.show-find) { root.show-find = false; root.find-query = ""; root.clear-find(); return accept; }
                if (root.show-settings) { root.show-settings = false; return accept; }
                root.clear-selection();
                return accept;
            }
            if (event.text == Key.F5) {
                root.refresh();
                return accept;
            }
            if (event.text == Key.F2) {
                root.start-rename();
                return accept;
            }
            if (event.text == Key.Delete) {
                root.delete-selected();
                return accept;
            }
            if (event.text == Key.Return) {
                root.open-selected();
                return accept;
            }
            if (event.text == Key.Backspace) {
                root.nav-up();
                return accept;
            }
            if (event.modifiers.control) {
                if (event.text == "a" || event.text == "A") { root.select-all(); return accept; }
                if (event.text == "o" || event.text == "O") { root.open-archive(); return accept; }
                if (event.text == "d" || event.text == "D") { root.choose-folder(); return accept; }
                if (event.text == "f" || event.text == "F") { root.show-find = !root.show-find; return accept; }
                if (event.text == "c" || event.text == "C") { root.copy-selected-path(); return accept; }
            }
            if (event.modifiers.alt) {
                if (event.text == "a" || event.text == "A") { root.create-archive(); return accept; }
                if (event.text == "e" || event.text == "E") { root.extract-archive(); return accept; }
                if (event.text == "t" || event.text == "T") { root.test-archive(); return accept; }
                if (event.text == "v" || event.text == "V") { root.view-selected(); return accept; }
                if (event.text == "i" || event.text == "I") { root.show-archive-info(); return accept; }
                if (event.text == "f" || event.text == "F") { root.show-find = true; return accept; }
                if (event.text == "x" || event.text == "X") { root.exit-app(); return accept; }
            }
            return reject;
        }

    VerticalBox {
        spacing: 0px;
        padding: 0px;

        // ---- Menu Bar (Neutral Dark Mode) ----
        Rectangle {
            height: 28px;
            background: root.dark-mode ? #171717 : #f4f5f3;
            border-width: 1px;
            border-color: root.dark-mode ? #262626 : #e0e2e6;

            HorizontalBox {
                padding-left: 6px;
                padding-right: 8px;
                spacing: 2px;

                MenuItem { dark-mode: root.dark-mode; active: root.active-menu == 1; caption: root.arabic-mode ? "ملف" : "File"; activated => { root.active-menu = (root.active-menu == 1 ? 0 : 1); } }
                MenuItem { dark-mode: root.dark-mode; active: root.active-menu == 2; caption: root.arabic-mode ? "أوامر" : "Commands"; activated => { root.active-menu = (root.active-menu == 2 ? 0 : 2); } }
                MenuItem { dark-mode: root.dark-mode; active: root.active-menu == 3; caption: root.arabic-mode ? "أدوات" : "Tools"; activated => { root.active-menu = (root.active-menu == 3 ? 0 : 3); } }
                MenuItem { dark-mode: root.dark-mode; active: root.active-menu == 4; caption: root.arabic-mode ? "المفضلة" : "Favorites"; activated => { root.active-menu = (root.active-menu == 4 ? 0 : 4); } }
                MenuItem { dark-mode: root.dark-mode; active: root.active-menu == 5; caption: root.arabic-mode ? "خيارات" : "Options"; activated => { root.active-menu = (root.active-menu == 5 ? 0 : 5); } }
                MenuItem { dark-mode: root.dark-mode; active: root.active-menu == 6; caption: root.arabic-mode ? "مساعدة" : "Help"; activated => { root.active-menu = (root.active-menu == 6 ? 0 : 6); } }

                Rectangle { horizontal-stretch: 1; }

                // Theme Toggle
                Rectangle {
                    width: 30px;
                    height: 22px;
                    border-radius: 3px;
                    background: theme-btn.pressed
                        ? (root.dark-mode ? #2c2c2c : #dcdcdc)
                        : (theme-btn.has-hover ? (root.dark-mode ? #262626 : #eaeaea) : transparent);
                    theme-btn := TouchArea { clicked => { root.active-menu = 0; root.toggle-theme(); } }

                    if root.dark-mode : Text {
                        text: "☼";
                        color: #e8573f;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if !root.dark-mode : Path {
                        x: 9px; y: 5px; width: 12px; height: 12px;
                        commands: "M 10.5 6.4 A 4.5 4.5 0 1 1 5.6 1.5 A 3.5 3.5 0 0 0 10.5 6.4 Z";
                        fill: #e8573f;
                    }
                }

                // Language Toggle
                Rectangle {
                    width: 44px;
                    height: 22px;
                    border-radius: 3px;
                    background: lang-btn.pressed
                        ? (root.dark-mode ? #2c2c2c : #dcdcdc)
                        : (lang-btn.has-hover ? (root.dark-mode ? #262626 : #eaeaea) : transparent);
                    lang-btn := TouchArea { clicked => { root.active-menu = 0; root.toggle-language(); } }
                    Text {
                        text: root.arabic-mode ? "EN" : "AR";
                        color: #e8573f;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ---- Modern Toolbar (Neutral Charcoal / Black, exact icons with orange badges) ----
        Rectangle {
            height: 70px;
            background: root.dark-mode ? #171717 : #f6f6f4;
            border-width: 1px;
            border-color: root.dark-mode ? #262626 : #e0e2e6;

            HorizontalBox {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 2px;

                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/add.svg");
                    icon-light: @image-url("../assets/icons-light/add.svg");
                    caption: root.arabic-mode ? "إضافة" : "Add";
                    activated => { root.active-menu = 0; root.create-archive(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/extract.svg");
                    icon-light: @image-url("../assets/icons-light/extract.svg");
                    caption: root.arabic-mode ? "استخراج" : "Extract To";
                    activated => { root.active-menu = 0; root.extract-archive(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/test.svg");
                    icon-light: @image-url("../assets/icons-light/test.svg");
                    caption: root.arabic-mode ? "اختبار" : "Test";
                    activated => { root.active-menu = 0; root.test-archive(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/view.svg");
                    icon-light: @image-url("../assets/icons-light/view.svg");
                    caption: root.arabic-mode ? "عرض" : "View";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.view-selected(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/delete.svg");
                    icon-light: @image-url("../assets/icons-light/delete.svg");
                    caption: root.arabic-mode ? "حذف" : "Delete";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.delete-selected(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/find.svg");
                    icon-light: @image-url("../assets/icons-light/find.svg");
                    caption: root.arabic-mode ? "بحث" : "Find";
                    activated => {
                        root.active-menu = 0;
                        root.show-context-menu = false;
                        root.show-find = !root.show-find;
                        if (!root.show-find) {
                            root.find-query = "";
                            root.clear-find();
                        }
                    }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/wizard.svg");
                    icon-light: @image-url("../assets/icons-light/wizard.svg");
                    caption: root.arabic-mode ? "معالج" : "Wizard";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.show-wizard = !root.show-wizard; }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/info.svg");
                    icon-light: @image-url("../assets/icons-light/info.svg");
                    caption: root.arabic-mode ? "معلومات" : "Info";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.show-archive-info(); }
                }

                // Vertical Separator between Info and VirusScan (Exactly as in reference image)
                VerticalLayout {
                    width: 9px;
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 38px;
                        background: root.dark-mode ? #2c2c2c : #d5d5d5;
                    }
                }

                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/virus.svg");
                    icon-light: @image-url("../assets/icons-light/virus.svg");
                    caption: root.arabic-mode ? "فحص" : "VirusScan";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.scan-viruses(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/comment.svg");
                    icon-light: @image-url("../assets/icons-light/comment.svg");
                    caption: root.arabic-mode ? "تعليق" : "Comment";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.show-archive-info(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/protect.svg");
                    icon-light: @image-url("../assets/icons-light/protect.svg");
                    caption: root.arabic-mode ? "حماية" : "Protect";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.create-encrypted-archive(); }
                }
                ToolbarButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/sfx.svg");
                    icon-light: @image-url("../assets/icons-light/sfx.svg");
                    caption: root.arabic-mode ? "ذاتي SFX" : "SFX";
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.create-sfx-archive(); }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ---- Compression Settings Drawer ----
        if root.show-settings : Rectangle {
            height: 175px;
            background: root.dark-mode ? #1a1a1a : #f4f5f3;
            border-width: 1px;
            border-color: #e8573f;

            VerticalLayout {
                padding: 12px;
                spacing: 7px;
                Text {
                    text: root.arabic-mode ? "إعدادات ضغط Mickey RAR الفائق Ultra" : "Mickey RAR — Ultra Compression Settings";
                    font-weight: 700;
                    font-size: 13px;
                    color: #e8573f;
                }
                Text {
                    text: root.arabic-mode ? "الصيغة: ZIP / 7Z   •   المستوى: Ultra (-mx=9)   •   الخوارزمية: LZMA2 / Deflate" : "Format: ZIP / 7Z   •   Level: Ultra (-mx=9)   •   Engine: LZMA2 / Deflate";
                    color: root.dark-mode ? #b0b0b0 : #555555;
                    font-size: 11.5px;
                }
                HorizontalBox {
                    spacing: 14px;
                    solid-box := CheckBox {
                        text: root.arabic-mode ? "ضغط متصل Solid" : "Solid compression";
                        checked: root.solid-mode;
                    }
                    Text {
                        text: root.arabic-mode ? "المعالجات (Threads):" : "Threads:";
                        vertical-alignment: center;
                        color: root.dark-mode ? #e2e2e2 : #1a1a1a;
                        font-size: 12px;
                    }
                    threads-input := LineEdit {
                        text: root.thread-count;
                        width: 70px;
                    }
                }
                HorizontalBox {
                    alignment: start;
                    spacing: 8px;
                    Button {
                        text: root.arabic-mode ? "حفظ" : "Save";
                        clicked => { root.save-compression-settings(threads-input.text, solid-box.checked); }
                    }
                    Button {
                        text: root.arabic-mode ? "إغلاق" : "Close";
                        clicked => { root.show-settings = false; }
                    }
                }
            }
        }

        // ---- Find / Search Bar Drawer ----
        if root.show-find : Rectangle {
            height: 42px;
            background: root.dark-mode ? #1a1a1a : #f4f5f3;
            border-width: 1px;
            border-color: #e8573f;

            HorizontalBox {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 8px;

                Text {
                    text: root.arabic-mode ? "بحث سريع:" : "Quick Find:";
                    color: #e8573f;
                    font-weight: 700;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 28px;
                    border-radius: 4px;
                    background: root.dark-mode ? #0d0d0d : #fafaf8;
                    border-width: 1px;
                    border-color: root.dark-mode ? #383838 : #cccccc;

                    find-input := TextInput {
                        x: 8px;
                        y: 0px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text <=> root.find-query;
                        color: root.dark-mode ? #f0f0f0 : #1e1e1e;
                        font-size: 12px;
                        vertical-alignment: center;
                        edited => { root.run-find(self.text); }
                        accepted => { root.run-find(self.text); }
                    }
                }

                Button {
                    text: root.arabic-mode ? "بحث" : "Search";
                    clicked => { root.run-find(root.find-query); }
                }
                Button {
                    text: root.arabic-mode ? "مسح وإغلاق" : "Clear & Close";
                    clicked => {
                        root.find-query = "";
                        root.show-find = false;
                        root.clear-find();
                    }
                }
            }
        }

        // ---- Wizard Quick Action Bar ----
        if root.show-wizard : Rectangle {
            height: 54px;
            background: root.dark-mode ? #1a1a1a : #f4f5f3;
            border-width: 1px;
            border-color: #e8573f;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                Text {
                    text: root.arabic-mode ? "معالج Mickey RAR السريع:" : "Quick Archive Wizard:";
                    color: #e8573f;
                    font-weight: 700;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }

                Button {
                    text: root.arabic-mode ? "1. فك ضغط أرشيف موجود..." : "1. Unpack an Archive...";
                    clicked => { root.show-wizard = false; root.extract-archive(); }
                }
                Button {
                    text: root.arabic-mode ? "2. إنشاء أرشيف مضغوط جديد..." : "2. Create New Archive...";
                    clicked => { root.show-wizard = false; root.create-archive(); }
                }
                Button {
                    text: root.arabic-mode ? "3. أرشيف مشفر بكلمة مرور..." : "3. Password-Protected Archive...";
                    clicked => { root.show-wizard = false; root.create-encrypted-archive(); }
                }
                Button {
                    text: root.arabic-mode ? "4. أرشيف ذاتي التشغيل (.exe)" : "4. Self-Extracting SFX (.exe)";
                    clicked => { root.show-wizard = false; root.create-sfx-archive(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "✕";
                    clicked => { root.show-wizard = false; }
                }
            }
        }

        // ---- Address Bar / Breadcrumb (Neutral Dark) ----
        Rectangle {
            height: 36px;
            background: root.dark-mode ? #141414 : #f0f1f4;
            border-width: 1px;
            border-color: root.dark-mode ? #282828 : #e0e2e6;

            HorizontalBox {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;

                NavButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/up.svg");
                    icon-light: @image-url("../assets/icons-light/up.svg");
                    activated => { root.active-menu = 0; root.show-context-menu = false; root.nav-up(); }
                }

                // Editable Path Input Field + Drives Dropdown Trigger
                Rectangle {
                    horizontal-stretch: 1;
                    height: 27px;
                    border-radius: 4px;
                    background: root.dark-mode ? #0d0d0d : #fafaf8;
                    border-width: 1px;
                    border-color: path-input.has-focus
                        ? #e8573f
                        : (root.dark-mode ? #2d2d2d : #cfd3da);

                    Image {
                        source: @image-url("../assets/icons/folder.svg");
                        x: 7px;
                        y: 5px;
                        width: 16px;
                        height: 16px;
                        image-fit: contain;
                    }

                    path-input := TextInput {
                        text <=> root.location;
                        x: 28px;
                        y: 0px;
                        width: parent.width - 56px;
                        height: parent.height;
                        color: root.dark-mode ? #dedede : #1a1a1a;
                        font-size: 12px;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => {
                            root.active-menu = 0;
                            root.show-context-menu = false;
                            root.navigate-path(self.text);
                            key-handler.focus();
                        }
                    }

                    Rectangle {
                        x: parent.width - 26px;
                        y: 1px;
                        width: 25px;
                        height: parent.height - 2px;
                        border-radius: 3px;
                        background: drv-touch.has-hover
                            ? (root.dark-mode ? #262626 : #ebebeb)
                            : transparent;

                        drv-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-context-menu = false;
                                root.active-menu = (root.active-menu == 7 ? 0 : 7);
                            }
                        }

                        Path {
                            x: (parent.width - 9px) / 2;
                            y: (parent.height - 5px) / 2;
                            width: 9px;
                            height: 5px;
                            commands: "M 0 0 L 9 0 L 4.5 5 Z";
                            fill: #e8573f;
                        }
                    }
                }
            }
        }

        // ---- Column Headers (Sortable) ----
        Rectangle {
            height: 26px;
            background: root.dark-mode ? #1a1a1a : #e8eaee;
            border-width: 1px;
            border-color: root.dark-mode ? #262626 : #dadde3;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 0px;

                HeaderCell {
                    dark-mode: root.dark-mode;
                    caption: (root.arabic-mode ? "الاسم" : "Names") + (root.sort-column == 0 ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    width: 38%;
                    clicked => { root.sort-by(0); }
                }
                Rectangle { width: 1px; height: 18px; y: 4px; background: root.dark-mode ? #2a2a2a : #d0d3d8; }
                HeaderCell {
                    dark-mode: root.dark-mode;
                    caption: (root.arabic-mode ? "الحجم" : "Size") + (root.sort-column == 1 ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    width: 13%;
                    clicked => { root.sort-by(1); }
                }
                Rectangle { width: 1px; height: 18px; y: 4px; background: root.dark-mode ? #2a2a2a : #d0d3d8; }
                HeaderCell {
                    dark-mode: root.dark-mode;
                    caption: (root.arabic-mode ? "المضغوط" : "Packed") + (root.sort-column == 2 ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    width: 13%;
                    clicked => { root.sort-by(2); }
                }
                Rectangle { width: 1px; height: 18px; y: 4px; background: root.dark-mode ? #2a2a2a : #d0d3d8; }
                HeaderCell {
                    dark-mode: root.dark-mode;
                    caption: (root.arabic-mode ? "النوع" : "Type") + (root.sort-column == 3 ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    width: 14%;
                    clicked => { root.sort-by(3); }
                }
                Rectangle { width: 1px; height: 18px; y: 4px; background: root.dark-mode ? #2a2a2a : #d0d3d8; }
                HeaderCell {
                    dark-mode: root.dark-mode;
                    caption: (root.arabic-mode ? "تاريخ التعديل" : "Modified") + (root.sort-column == 4 ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    width: 14%;
                    clicked => { root.sort-by(4); }
                }
                Rectangle { width: 1px; height: 18px; y: 4px; background: root.dark-mode ? #2a2a2a : #d0d3d8; }
                HeaderCell {
                    dark-mode: root.dark-mode;
                    caption: "CRC32" + (root.sort-column == 5 ? (root.sort-ascending ? " ↑" : " ↓") : "");
                    horizontal-stretch: 1;
                    clicked => { root.sort-by(5); }
                }
            }
        }

        // ---- File List (Pure Neutral Black / Charcoal background) ----
        Rectangle {
            vertical-stretch: 1;
            min-height: 0px;
            clip: true;
            background: root.dark-mode ? #0b0b0b : #f6f6f4;

            ListView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;

                for entry[idx] in root.entries : row-touch := TouchArea {
                    height: 26px;

                        property <bool> is-dragging-row: false;
                        property <length> press-x;
                        property <length> press-y;
                        property <bool> last-ctrl: false;
                        property <bool> last-shift: false;

                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                self.press-x = self.mouse-x;
                                self.press-y = self.mouse-y;
                                self.last-ctrl = event.modifiers.control;
                                self.last-shift = event.modifiers.shift;
                                self.is-dragging-row = false;
                            }
                            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                                root.active-menu = 0;
                                if (!entry.is-selected) {
                                    root.select-entry-adv(idx, false, false);
                                }
                                root.context-menu-x = Math.max(8px, Math.min(self.absolute-position.x + self.mouse-x, root.width - 235px));
                                root.context-menu-y = Math.max(32px, Math.min(self.absolute-position.y + self.mouse-y, root.height - 210px));
                                root.show-context-menu = true;
                                key-handler.focus();
                            }
                            if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                                self.is-dragging-row = false;
                            }
                        }

                        moved => {
                            if (self.pressed && !self.is-dragging-row) {
                                let dx = self.mouse-x - self.press-x;
                                let dy = self.mouse-y - self.press-y;
                                if (dx > 10px || dx < -10px || dy > 10px || dy < -10px) {
                                    self.is-dragging-row = true;
                                    root.start-drag(idx);
                                }
                            }
                        }

                        clicked => {
                            root.active-menu = 0;
                            root.show-context-menu = false;
                            key-handler.focus();
                            if (entry.name == "..") {
                                root.open-entry("..");
                            } else {
                                root.select-entry-adv(idx, self.last-ctrl, self.last-shift);
                            }
                        }

                        double-clicked => {
                            root.active-menu = 0;
                            root.show-context-menu = false;
                            root.open-entry(entry.name);
                        }

                        Rectangle {
                            width: 100%;
                            height: 100%;

                            // Neutral grey selection highlight matching the reference image!
                            background: entry.is-selected
                                ? (root.dark-mode ? #2c2c2c : #d8e2ec)
                                : (row-touch.has-hover ? (root.dark-mode ? #1d1d1d : #eceee9) : transparent);

                            border-width: entry.is-selected ? 1px : 0px;
                            border-color: root.dark-mode ? #4a4a4a : #b0c4de;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 0px;

                                // Column 1: Icon + Name
                                Rectangle {
                                    width: 38%;
                                    height: parent.height;
                                    clip: true;

                                    Image {
                                        source: entry.icon-kind == "dir"
                                            ? (root.dark-mode
                                                ? @image-url("../assets/icons/folder.svg")
                                                : @image-url("../assets/icons-light/folder.svg"))
                                            : (entry.icon-kind == "zip"
                                                ? @image-url("../assets/icon-window.png")
                                                : (entry.icon-kind == "exe"
                                                    ? (root.dark-mode
                                                        ? @image-url("../assets/icons/file-exe.svg")
                                                        : @image-url("../assets/icons-light/file-exe.svg"))
                                                    : (entry.icon-kind == "txt"
                                                        ? (root.dark-mode
                                                            ? @image-url("../assets/icons/file-txt.svg")
                                                            : @image-url("../assets/icons-light/file-txt.svg"))
                                                        : (entry.icon-kind == "dll"
                                                            ? (root.dark-mode
                                                                ? @image-url("../assets/icons/file-dll.svg")
                                                                : @image-url("../assets/icons-light/file-dll.svg"))
                                                            : (root.dark-mode
                                                                ? @image-url("../assets/icons/file.svg")
                                                                : @image-url("../assets/icons-light/file.svg"))))));
                                        x: 4px;
                                        y: 5px;
                                        width: 16px;
                                        height: 16px;
                                        image-fit: contain;
                                    }

                                    Text {
                                        text: entry.name;
                                        x: 26px;
                                        y: 0px;
                                        width: parent.width - 30px;
                                        height: parent.height;
                                        color: entry.is-selected
                                            ? (root.dark-mode ? #ffffff : #111111)
                                            : (root.dark-mode ? #e0e0e0 : #1e1e1e);
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Column 2: Size
                                Rectangle {
                                    width: 13%;
                                    height: parent.height;
                                    clip: true;
                                    Text {
                                        text: entry.size;
                                        x: 8px;
                                        y: 0px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        color: entry.is-selected
                                            ? (root.dark-mode ? #ffffff : #111111)
                                            : (root.dark-mode ? #999999 : #555555);
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Column 3: Packed
                                Rectangle {
                                    width: 13%;
                                    height: parent.height;
                                    clip: true;
                                    Text {
                                        text: entry.packed;
                                        x: 8px;
                                        y: 0px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        color: entry.is-selected
                                            ? (root.dark-mode ? #ffffff : #111111)
                                            : (root.dark-mode ? #999999 : #555555);
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Column 4: Type
                                Rectangle {
                                    width: 14%;
                                    height: parent.height;
                                    clip: true;
                                    Text {
                                        text: entry.entry-type;
                                        x: 8px;
                                        y: 0px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        color: entry.is-selected
                                            ? (root.dark-mode ? #ffffff : #111111)
                                            : (root.dark-mode ? #999999 : #555555);
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Column 5: Modified
                                Rectangle {
                                    width: 14%;
                                    height: parent.height;
                                    clip: true;
                                    Text {
                                        text: entry.modified;
                                        x: 8px;
                                        y: 0px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        color: entry.is-selected
                                            ? (root.dark-mode ? #ffffff : #111111)
                                            : (root.dark-mode ? #999999 : #555555);
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // Column 6: CRC32
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: parent.height;
                                    clip: true;
                                    Text {
                                        text: entry.crc32;
                                        x: 8px;
                                        y: 0px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        color: entry.is-selected
                                            ? (root.dark-mode ? #ffffff : #111111)
                                            : (root.dark-mode ? #999999 : #555555);
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                }
            }
        }

        // ---- Modern Status Bar with Facebook & Instagram Social Icons ----
        Rectangle {
            height: 26px;
            background: root.dark-mode ? #171717 : #e8eaee;
            border-width: 1px;
            border-color: root.dark-mode ? #262626 : #dadde3;

            HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;

                // Left side: Selection icon + info
                Image {
                    source: root.dark-mode
                        ? @image-url("../assets/icons/status-select.svg")
                        : @image-url("../assets/icons-light/status-select.svg");
                    width: 15px;
                    height: 15px;
                    image-fit: contain;
                }

                Text {
                    text: root.selected-info;
                    color: root.dark-mode ? #b0b0b0 : #444444;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    width: 320px;
                }

                Rectangle { horizontal-stretch: 1; }

                // Right side: Total summary info
                Text {
                    text: root.total-info;
                    color: #e8573f;
                    font-size: 11px;
                    font-weight: 500;
                    vertical-alignment: center;
                }

                // Vertical Divider
                Rectangle {
                    width: 1px;
                    height: 14px;
                    background: root.dark-mode ? #2c2c2c : #d0d0d0;
                }

                // Facebook Social Icon
                SocialButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/facebook.svg");
                    icon-light: @image-url("../assets/icons-light/facebook.svg");
                    url: "https://www.facebook.com/michaelmagedm";
                    activated(url) => { root.open-url(url); }
                }

                // Instagram Social Icon
                SocialButton {
                    dark-mode: root.dark-mode;
                    icon: @image-url("../assets/icons/instagram.svg");
                    icon-light: @image-url("../assets/icons-light/instagram.svg");
                    url: "https://www.instagram.com/michaelmagedm/";
                    activated(url) => { root.open-url(url); }
                }
            }
        }
    }

    // ========================================================
    // POPUP WINRAR MENUS (Rendered on top of window content)
    // ========================================================

    // Backdrop click-catcher to dismiss menu when clicking outside
    if root.active-menu != 0 || root.show-context-menu : TouchArea {
        x: 0px;
        y: 28px;
        width: parent.width;
        height: parent.height - 28px;
        clicked => {
            root.active-menu = 0;
            root.show-context-menu = false;
        }
    }

    // 1. File Menu
    if root.active-menu == 1 : DropdownMenu {
        x: 6px;
        y: 28px;
        width: 230px;
        height: m1-layout.preferred-height;
        dark-mode: root.dark-mode;

        m1-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "فتح أرشيف..." : "Open archive..."; shortcut: "Ctrl+O"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.open-archive(); } }
            DropdownMenuItem { text: root.arabic-mode ? "اختيار مجلد..." : "Choose folder..."; shortcut: "Ctrl+D"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.choose-folder(); } }
            DropdownMenuItem { text: root.arabic-mode ? "تحديث" : "Refresh"; shortcut: "F5"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.refresh(); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "تحديد الكل" : "Select all"; shortcut: "Ctrl+A"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.select-all(); } }
            DropdownMenuItem { text: root.arabic-mode ? "عكس التحديد" : "Invert selection"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.invert-selection(); } }
            DropdownMenuItem { text: root.arabic-mode ? "إلغاء التحديد" : "Clear selection"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.clear-selection(); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "خروج" : "Exit"; shortcut: "Alt+X"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.exit-app(); } }
        }
    }

    // 2. Commands Menu
    if root.active-menu == 2 : DropdownMenu {
        x: 52px;
        y: 28px;
        width: 280px;
        height: m2-layout.preferred-height;
        dark-mode: root.dark-mode;

        m2-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "إضافة ملفات للأرشيف..." : "Add files to archive..."; shortcut: "Alt+A"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.create-archive(); } }
            DropdownMenuItem { text: root.arabic-mode ? "استخراج إلى المجلد المحدد..." : "Extract to specified folder..."; shortcut: "Alt+E"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.extract-archive(); } }
            DropdownMenuItem { text: root.arabic-mode ? "اختبار سلامة الأرشيف" : "Test archived files"; shortcut: "Alt+T"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.test-archive(); } }
            DropdownMenuItem { text: root.arabic-mode ? "عرض الملف" : "View file"; shortcut: "Alt+V"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.view-selected(); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "إعادة تسمية" : "Rename"; shortcut: "F2"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.start-rename(); } }
            DropdownMenuItem { text: root.arabic-mode ? "حذف الملفات" : "Delete files"; shortcut: "Del"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.delete-selected(); } }
            DropdownMenuItem { text: root.arabic-mode ? "تشفير وحماية الأرشيف بكلمة مرور" : "Password-protect archive"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.create-encrypted-archive(); } }
            DropdownMenuItem { text: root.arabic-mode ? "إنشاء أرشيف تشغيل ذاتي SFX" : "Create SFX archive (.exe)"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.create-sfx-archive(); } }
        }
    }

    // 3. Tools Menu
    if root.active-menu == 3 : DropdownMenu {
        x: 140px;
        y: 28px;
        width: 270px;
        height: m3-layout.preferred-height;
        dark-mode: root.dark-mode;

        m3-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "البحث عن ملفات..." : "Find files..."; shortcut: "Ctrl+F"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.show-find = true; } }
            DropdownMenuItem { text: root.arabic-mode ? "معلومات الأرشيف" : "Show information..."; shortcut: "Alt+I"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.show-archive-info(); } }
            DropdownMenuItem { text: root.arabic-mode ? "معالج الاستخراج والضغط" : "Wizard..."; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.show-wizard = true; } }
            DropdownMenuItem { text: root.arabic-mode ? "فحص الأرشيف من الفيروسات" : "Scan archive for viruses"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.scan-viruses(); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "اختبار الأداء والسرعة Benchmark" : "Benchmark & hardware test"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.run-benchmark(); } }
        }
    }

    // 4. Favorites Menu
    if root.active-menu == 4 : DropdownMenu {
        x: 198px;
        y: 28px;
        width: 220px;
        height: m4-layout.preferred-height;
        dark-mode: root.dark-mode;

        m4-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "سطح المكتب Desktop" : "Desktop"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.nav-favorite("desktop"); } }
            DropdownMenuItem { text: root.arabic-mode ? "التنزيلات Downloads" : "Downloads"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.nav-favorite("downloads"); } }
            DropdownMenuItem { text: root.arabic-mode ? "المستندات Documents" : "Documents"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.nav-favorite("documents"); } }
            DropdownMenuItem { text: root.arabic-mode ? "الصور Pictures" : "Pictures"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.nav-favorite("pictures"); } }
        }
    }

    // 5. Options Menu
    if root.active-menu == 5 : DropdownMenu {
        x: 270px;
        y: 28px;
        width: 260px;
        height: m5-layout.preferred-height;
        dark-mode: root.dark-mode;

        m5-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "إعدادات الضغط الفائق Ultra..." : "Compression Settings (Ultra)..."; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.show-settings = true; } }
            DropdownMenuItem { text: root.arabic-mode ? "تعيين كبرنامج افتراضي لملفات الأرشيف" : "Set as Default Archive Manager"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.set-default-app(); } }
            DropdownMenuItem { text: root.arabic-mode ? "تبديل المظهر: داكن / فاتح" : "Toggle Theme: Dark / Light"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.toggle-theme(); } }
            DropdownMenuItem { text: root.arabic-mode ? "تغيير اللغة: English" : "Switch Language: العربية"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.toggle-language(); } }
        }
    }

    // 6. Help Menu
    if root.active-menu == 6 : DropdownMenu {
        x: 340px;
        y: 28px;
        width: 230px;
        height: m6-layout.preferred-height;
        dark-mode: root.dark-mode;

        m6-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "صفحة الفيسبوك" : "Facebook Page"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.open-url("https://www.facebook.com/michaelmagedm"); } }
            DropdownMenuItem { text: root.arabic-mode ? "صفحة الإنستغرام" : "Instagram Profile"; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.open-url("https://www.instagram.com/michaelmagedm/"); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "التحقق من وجود تحديثات..." : "Check for updates..."; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.check-updates(); } }
            DropdownMenuItem { text: root.arabic-mode ? "حول Mickey RAR..." : "About Mickey RAR..."; dark-mode: root.dark-mode; activated => { root.active-menu = 0; root.show-about(); } }
        }
    }

    // 7. Drives & Quick Browse Dropdown (from Address Bar arrow)
    if root.active-menu == 7 : DropdownMenu {
        x: parent.width - 230px;
        y: 132px;
        width: 220px;
        height: m7-layout.preferred-height;
        dark-mode: root.dark-mode;

        m7-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            for drv in root.available-drives : DropdownMenuItem {
                text: (root.arabic-mode ? "قرص محلي " : "Local Disk ") + drv;
                dark-mode: root.dark-mode;
                activated => { root.active-menu = 0; root.navigate-path(drv); }
            }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem {
                text: root.arabic-mode ? "استعراض مجلد..." : "Browse for folder...";
                shortcut: "Ctrl+D";
                dark-mode: root.dark-mode;
                activated => { root.active-menu = 0; root.choose-folder(); }
            }
        }
    }

    // 8. In-App Right-Click Context Menu on File Rows
    if root.show-context-menu : DropdownMenu {
        x: root.context-menu-x;
        y: root.context-menu-y;
        width: 225px;
        height: ctx-layout.preferred-height;
        dark-mode: root.dark-mode;

        ctx-layout := VerticalLayout {
            padding: 4px;
            spacing: 1px;

            DropdownMenuItem { text: root.arabic-mode ? "فتح / عرض" : "Open / View"; shortcut: "Enter"; dark-mode: root.dark-mode; activated => { root.show-context-menu = false; root.open-selected(); } }
            DropdownMenuItem { text: root.arabic-mode ? "استخراج المحدد إلى..." : "Extract selected to..."; shortcut: "Alt+E"; dark-mode: root.dark-mode; activated => { root.show-context-menu = false; root.extract-archive(); } }
            DropdownMenuItem { text: root.arabic-mode ? "إضافة إلى أرشيف..." : "Add to archive..."; shortcut: "Alt+A"; dark-mode: root.dark-mode; activated => { root.show-context-menu = false; root.create-archive(); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "إعادة تسمية..." : "Rename..."; shortcut: "F2"; dark-mode: root.dark-mode; activated => { root.show-context-menu = false; root.start-rename(); } }
            DropdownMenuItem { text: root.arabic-mode ? "نسخ المسار" : "Copy path"; shortcut: "Ctrl+C"; dark-mode: root.dark-mode; activated => { root.show-context-menu = false; root.copy-selected-path(); } }
            MenuDivider { dark-mode: root.dark-mode; }
            DropdownMenuItem { text: root.arabic-mode ? "حذف" : "Delete"; shortcut: "Del"; dark-mode: root.dark-mode; activated => { root.show-context-menu = false; root.delete-selected(); } }
        }
    }

    // 9. Rename Modal Overlay
    if root.show-rename : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000088;
        TouchArea { clicked => { root.show-rename = false; } }

        Rectangle {
            x: (parent.width - 380px) / 2;
            y: (parent.height - 155px) / 2;
            width: 380px;
            height: 155px;
            border-radius: 6px;
            background: root.dark-mode ? #171717 : #f7f7f5;
            border-width: 1px;
            border-color: #e8573f;
            TouchArea {}

            VerticalBox {
                padding: 14px;
                spacing: 10px;
                Text {
                    text: root.arabic-mode ? "إعادة تسمية العنصر" : "Rename Item";
                    font-size: 14px;
                    font-weight: 700;
                    color: root.dark-mode ? #f0f0f0 : #1e1e1e;
                }
                LineEdit {
                    text <=> root.rename-new-name;
                    accepted => {
                        root.show-rename = false;
                        root.confirm-rename(root.rename-old-name, root.rename-new-name);
                    }
                }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.arabic-mode ? "إلغاء" : "Cancel";
                        clicked => { root.show-rename = false; }
                    }
                    Button {
                        text: root.arabic-mode ? "حفظ الاسم" : "Rename";
                        clicked => {
                            root.show-rename = false;
                            root.confirm-rename(root.rename-old-name, root.rename-new-name);
                        }
                    }
                }
            }
        }
    }

    // 10. Archive / Folder Information Modal Overlay
    if root.show-info-dialog : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000088;
        TouchArea { clicked => { root.show-info-dialog = false; } }

        Rectangle {
            x: (parent.width - 430px) / 2;
            y: (parent.height - 230px) / 2;
            width: 430px;
            height: 230px;
            border-radius: 6px;
            background: root.dark-mode ? #171717 : #f7f7f5;
            border-width: 1px;
            border-color: #e8573f;
            TouchArea {}

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.info-dialog-title;
                    font-size: 15px;
                    font-weight: 700;
                    color: #e8573f;
                }
                Rectangle { height: 1px; background: root.dark-mode ? #2c2c2c : #dddddd; }
                Text {
                    text: root.info-dialog-body;
                    font-size: 12px;
                    color: root.dark-mode ? #e0e0e0 : #1a1a1a;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    Button {
                        text: root.arabic-mode ? "حسناً" : "OK";
                        clicked => { root.show-info-dialog = false; }
                    }
                }
            }
        }
    }

    // 11. Software Update Modal Overlay
    if root.show-update-dialog : Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: #00000088;
        TouchArea {
            clicked => {
                if (!root.update-downloading) {
                    root.show-update-dialog = false;
                }
            }
        }

        Rectangle {
            x: (parent.width - 450px) / 2;
            y: (parent.height - 250px) / 2;
            width: 450px;
            height: 250px;
            border-radius: 6px;
            background: root.dark-mode ? #171717 : #f7f7f5;
            border-width: 1px;
            border-color: #e8573f;
            TouchArea {}

            VerticalBox {
                padding: 16px;
                spacing: 10px;
                Text {
                    text: root.update-dialog-title;
                    font-size: 15px;
                    font-weight: 700;
                    color: #e8573f;
                }
                Rectangle { height: 1px; background: root.dark-mode ? #2c2c2c : #dddddd; }
                Text {
                    text: root.update-dialog-body;
                    font-size: 12px;
                    color: root.dark-mode ? #e0e0e0 : #1a1a1a;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalBox {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.update-has-new
                            ? (root.arabic-mode ? "لاحقاً" : "Later")
                            : (root.arabic-mode ? "حسناً" : "OK");
                        enabled: !root.update-downloading;
                        clicked => { root.show-update-dialog = false; }
                    }
                    if root.update-has-new : Button {
                        text: root.update-downloading
                            ? (root.arabic-mode ? "جاري التنزيل..." : "Downloading...")
                            : (root.arabic-mode ? "تحديث وتثبيت الآن" : "Update & Install Now");
                        enabled: !root.update-downloading;
                        clicked => { root.install-update(); }
                    }
                }
            }
        }
    }
    }
}
